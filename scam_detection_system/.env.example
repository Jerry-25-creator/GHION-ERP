# ---------------------------------------------------------------
# Example configuration. Copy this file to ".env" and edit values:
#     copy .env.example .env        (Windows)
# NEVER commit the real .env file - it is listed in .gitignore.
# ---------------------------------------------------------------

# Secret key used to sign sessions and CSRF tokens.
# Generate one with:
#     python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-me-with-a-long-random-value

# FLASK_DEBUG=1 enables auto-reload and detailed error pages while you are
# developing. Keep it 0 for demonstrations: the debugger must never be
# reachable by other people.
FLASK_DEBUG=0
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

# Maximum number of characters accepted for a single message.
MAX_MESSAGE_LENGTH=5000

# Admin session length in minutes (admins are logged out afterwards).
ADMIN_SESSION_MINUTES=60

# Set to 1 only when the site is served over HTTPS.
SESSION_COOKIE_SECURE=0

# 1 = replace phone numbers and e-mail addresses in stored messages.
REDACT_STORED_MESSAGES=1

# Rate limits: failed logins per IP before a lockout, lockout length, and
# analyses allowed per IP per minute.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
ANALYSIS_RATE_LIMIT_PER_MINUTE=30

# Admin accounts are NOT configured here. Create one with:
#     python create_admin.py
